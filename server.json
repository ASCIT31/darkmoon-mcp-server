{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ASCIT31/darkmoon-mcp-server",
  "title": "Darkmoon",
  "description": "Drive a self-hosted Darkmoon Pro autonomous AI pentest instance: start runs, poll status, read campaigns and findings.",
  "repository": {
    "url": "https://github.com/ASCIT31/Dark-Moon",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@darkmoon_ai/mcp-server",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DARKMOON_BASE_URL",
          "description": "Base URL of your self-hosted Darkmoon Pro Dashboard API",
          "isRequired": true
        },
        {
          "name": "DARKMOON_USERNAME",
          "description": "Dashboard user",
          "isRequired": false
        },
        {
          "name": "DARKMOON_PASSWORD",
          "description": "Dashboard password",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "DARKMOON_TOKEN",
          "description": "Pre-issued JWT, alternative to username/password",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}